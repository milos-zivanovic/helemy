msgstr "Helemy: promena lozinke"

#: users/services.py:55
#, python-format
msgid ""
"Someone asked to reset the password for %(email)s.\n"
"\n"
"Open this link to choose a new password (valid for %(minutes)s minutes):\n"
"%(link)s\n"
"\n"
"If it wasn't you, ignore this email; your password stays the same."
msgstr ""
"Zatražena je promena lozinke za %(email)s.\n"
"\n"
"Otvorite ovaj link da izaberete novu lozinku (važi %(minutes)s minuta):\n"
"%(link)s\n"
"\n"
"Ako to niste bili vi, zanemarite ovaj email; lozinka ostaje ista."

#: users/services.py:100
msgid "Helemy: confirm your email address"
msgstr "Helemy: potvrda email adrese"

#: users/services.py:102
#, python-format
msgid ""
"Welcome to Helemy!\n"
"\n"
"Open this link to confirm %(email)s and finish signing up (valid for "
"%(hours)s hours):\n"
"%(link)s\n"
"\n"
"If you didn't sign up, ignore this email."
msgstr ""
"Dobro došli u Helemy!\n"
"\n"
"Otvorite ovaj link da potvrdite %(email)s i završite registraciju (važi "
"%(hours)s sati):\n"
"%(link)s\n"
"\n"
"Ako se niste registrovali, zanemarite ovaj email."

