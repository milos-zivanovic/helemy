#: common/images.py:28
#, python-format
msgid "The image is too large (at most %(mb)s MB)."
msgstr "Slika je prevelika (najviše %(mb)s MB)."

#: common/images.py:33 common/images.py:41
msgid "Upload a JPEG, PNG or WebP image."
msgstr "Pošaljite JPEG, PNG ili WebP sliku."

#: common/images.py:35
msgid "The image has too many pixels."
msgstr "Slika ima previše piksela."

#: common/mixins.py:40
msgid "You do not belong to any household."
msgstr "Ne pripadate nijednom domaćinstvu."

#: common/third_party_messages.py:17
msgid "This field may not be blank."
msgstr "Ovo polje ne sme biti prazno."

#: common/third_party_messages.py:18
msgid "This field may not be null."
msgstr "Ovo polje mora imati vrednost."

#: common/third_party_messages.py:19
msgid "Not a valid string."
msgstr "Vrednost nije ispravan tekst."

#: common/third_party_messages.py:20
#, python-brace-format
msgid "Ensure this field has no more than {max_length} characters."
msgstr "Ovo polje može imati najviše {max_length} karaktera."

#: common/third_party_messages.py:21
#, python-brace-format
msgid "Ensure this field has at least {min_length} characters."
msgstr "Ovo polje mora imati najmanje {min_length} karaktera."

#: common/third_party_messages.py:22
msgid "A valid integer is required."
msgstr "Unesite ceo broj."

#: common/third_party_messages.py:23
msgid "A valid number is required."
msgstr "Unesite ispravan broj."

#: common/third_party_messages.py:24
#, python-brace-format
msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Vrednost mora biti manja ili jednaka {max_value}."

#: common/third_party_messages.py:25
#, python-brace-format
msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Vrednost mora biti veća ili jednaka {min_value}."

#: common/third_party_messages.py:26
msgid "String value too large."
msgstr "Tekst je predugačak."

#: common/third_party_messages.py:27
#, python-brace-format
msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Broj može imati najviše {max_digits} cifara ukupno."

#: common/third_party_messages.py:28
#, python-brace-format
msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr "Broj može imati najviše {max_decimal_places} decimala."

#: common/third_party_messages.py:30
#, python-brace-format
msgid ""
"Ensure that there are no more than {max_whole_digits} digits before the "
"decimal point."
msgstr ""
"Broj može imati najviše {max_whole_digits} cifara pre decimalnog zareza."

#: common/third_party_messages.py:32
#, python-brace-format
msgid "Date has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Datum nije u ispravnom formatu. Koristite jedan od ovih formata: {format}."

#: common/third_party_messages.py:33
#, python-brace-format
msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr ""
"Datum i vreme nisu u ispravnom formatu. Koristite jedan od ovih formata: "
"{format}."

#: common/third_party_messages.py:34
msgid "Expected a date but got a datetime."
msgstr "Očekivan je datum, a ne datum i vreme."

#: common/third_party_messages.py:35
msgid "Must be a valid boolean."
msgstr "Vrednost mora biti tačno ili netačno."

#: common/third_party_messages.py:36
#, python-brace-format
msgid "\"{input}\" is not a valid choice."
msgstr "„{input}“ nije dozvoljena vrednost."

#: common/third_party_messages.py:37
#, python-brace-format
msgid "Expected a list of items but got type \"{input_type}\"."
msgstr "Očekivana je lista, a stigao je tip „{input_type}“."

#: common/third_party_messages.py:38
msgid "This list may not be empty."
msgstr "Lista ne sme biti prazna."

#: common/third_party_messages.py:39
msgid "This selection may not be empty."
msgstr "Izaberite bar jednu stavku."

#: common/third_party_messages.py:40
#, python-brace-format
msgid "Invalid data. Expected a dictionary, but got {datatype}."
msgstr "Neispravni podaci. Očekivan je objekat, a stigao je {datatype}."

#: common/third_party_messages.py:41
msgid "The submitted data was not a file. Check the encoding type on the form."
msgstr "Poslati podaci nisu fajl. Proverite tip kodiranja forme."

#: common/third_party_messages.py:42
msgid "No filename could be determined."
msgstr "Nije moguće utvrditi naziv fajla."

#: common/third_party_messages.py:44
#, python-brace-format
msgid "Invalid pk \"{pk_value}\" - object does not exist."
msgstr "Neispravan ID „{pk_value}“: objekat ne postoji."

#: common/third_party_messages.py:45
#, python-brace-format
msgid "Incorrect type. Expected pk value, received {data_type}."
msgstr "Pogrešan tip. Očekivan je ID, a stigao je {data_type}."

#: common/third_party_messages.py:47
msgid "This field must be unique."
msgstr "Ova vrednost već postoji."

#: common/third_party_messages.py:48
#, python-brace-format
msgid "The fields {field_names} must make a unique set."
msgstr "Kombinacija polja {field_names} mora biti jedinstvena."

#: common/third_party_messages.py:50
msgid "A server error occurred."
msgstr "Došlo je do greške na serveru."

#: common/third_party_messages.py:51
msgid "Invalid input."
msgstr "Neispravan unos."

#: common/third_party_messages.py:52
msgid "Malformed request."
msgstr "Neispravan zahtev."

#: common/third_party_messages.py:53
msgid "Incorrect authentication credentials."
msgstr "Neispravni podaci za prijavu."

#: common/third_party_messages.py:54
msgid "Authentication credentials were not provided."
msgstr "Niste prijavljeni."

#: common/third_party_messages.py:55
msgid "You do not have permission to perform this action."
msgstr "Nemate dozvolu za ovu radnju."

#: common/third_party_messages.py:56
msgid "Not found."
msgstr "Nije pronađeno."

#: common/third_party_messages.py:57
#, python-brace-format
msgid "Method \"{method}\" not allowed."
msgstr "Metoda „{method}“ nije dozvoljena."

#: common/third_party_messages.py:58
#, python-brace-format
msgid "Unsupported media type \"{media_type}\" in request."
msgstr "Tip sadržaja „{media_type}“ nije podržan."

#: common/third_party_messages.py:59
msgid "Request was throttled."
msgstr "Previše zahteva. Pokušajte ponovo kasnije."

#: common/third_party_messages.py:61
msgid "Invalid page."
msgstr "Neispravna stranica."

#: common/third_party_messages.py:65
msgid "No active account found with the given credentials"
msgstr "Pogrešan email ili lozinka."

#: common/third_party_messages.py:66
msgid "Given token not valid for any token type"
msgstr "Token nije ispravan."

#: common/third_party_messages.py:67
msgid "Token is invalid or expired"
msgstr "Token nije ispravan ili je istekao."

#: common/third_party_messages.py:68
msgid "Token is blacklisted"
msgstr "Token je opozvan."

#: common/third_party_messages.py:69
msgid "User not found"
msgstr "Korisnik nije pronađen."

#: common/third_party_messages.py:70
msgid "User is inactive"
msgstr "Korisnički nalog nije aktivan."

#: common/third_party_messages.py:71
msgid "Token contained no recognizable user identification"
msgstr "Token ne sadrži podatke o korisniku."

#: common/third_party_messages.py:72
msgid "Authorization header must contain two space-delimited values"
msgstr ""
"Zaglavlje Authorization mora sadržati dve vrednosti razdvojene razmakom."

#: common/third_party_messages.py:78
#, python-format
msgid "The password is too similar to the %(verbose_name)s."
msgstr "Lozinka je previše slična polju „%(verbose_name)s“."

